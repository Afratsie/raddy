# Raddyfile example — mirrors RADDYFILE_SPEC §7.
# Global block (must be first if present).
{
    acme_email ops@example.com
    log_level info
}

# HTTP → HTTPS redirect on :80.
:80 {
    redir https://{host}{uri} permanent
}

# Main site: static files under /static, everything else to the app.
api.example.com {
    handle /static/* {
        root /var/www/html
        file_server
        encode zstd gzip
    }

    reverse_proxy 127.0.0.1:8080
    header_up X-Real-IP {remote_host}
}
